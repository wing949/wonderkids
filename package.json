{
  "name": "wonderkids-vn-elearning",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test test/*.test.mjs",
    "generate:curriculum-audio": "node scripts/generate_curriculum_audio.mjs",
    "verify:curriculum-audio": "node scripts/generate_curriculum_audio.mjs --verify",
    "verify:vietnamese-audio": "node scripts/verify_vietnamese_audio_manifest.mjs",
    "sync:vietnamese-audio-metadata": "node scripts/sync_vietnamese_audio_metadata.mjs",
    "generate:vietnamese-verified-audio": "node scripts/generate_verified_vietnamese_audio.mjs",
    "migrate:vietnamese-audio": "python scripts/remove_vietnamese_audio_disclosure.py",
    "audit:vietnamese": "node scripts/audit_vietnamese_sgk_rollout.mjs",
    "import:vietnamese-sources": "node --use-system-ca scripts/import_vietnamese_sgk_sources.mjs",
    "verify:vietnamese-sources": "node --use-system-ca scripts/import_vietnamese_sgk_sources.mjs --verify",
    "ocr:vietnamese-sources": "python scripts/ocr_vietnamese_sgk_sources.py",
    "verify:vietnamese-ocr": "python scripts/ocr_vietnamese_sgk_sources.py --verify",
    "audit:vietnamese-pages": "node scripts/audit_vietnamese_page_mappings.mjs",
    "build": "tsc && vite build",
    "deploy": "vercel --prod",
    "preview": "vite preview"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "howler": "^2.2.4",
    "lucide-react": "^0.475.0",
    "msedge-tts": "^2.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/howler": "^2.2.12",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tesseract.js": "^7.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
